<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tgwei.demopet.demos.web.mapper.SysUserMapper">

    <!-- 查询全部员工信息（支持筛选） -->
    <select id="getAllSysUserEmployee" resultType="com.tgwei.demopet.demos.web.entity.SysUser">
        SELECT * FROM sys_user
        WHERE (role='foster_staff' OR role='veterinarian')
        <if test="roleSpecialty != null and roleSpecialty != ''">
            AND role_specialty = #{roleSpecialty}
        </if>
        <if test="role != null and role != ''">
            AND role = #{role}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY id DESC
    </select>

</mapper>
